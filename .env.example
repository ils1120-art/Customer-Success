# ---- Anthropic / Claude ----
ANTHROPIC_API_KEY=sk-ant-...
# Fast, cheap model for the CS / not-CS classification step
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
# Stronger model for synthesizing the briefing
ANALYST_MODEL=claude-sonnet-4-6

# ---- Gmail ----
# Path to the OAuth client downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json
# Where the cached OAuth token is stored after first authorization
GMAIL_TOKEN_FILE=token.json
# Gmail search query used to find candidate new mail (polling window)
GMAIL_POLL_QUERY=in:inbox is:unread newer_than:1d
# Label applied to emails identified as CS-related (created if missing)
GMAIL_CS_LABEL=CS

# ---- Discord ----
DISCORD_BOT_TOKEN=
# Your Discord user ID — the agent DMs your briefing here
DISCORD_OWNER_ID=
# Optional: post the briefing to this channel instead of a DM (leave blank to DM)
DISCORD_BRIEFING_CHANNEL_ID=
# Comma-separated channel IDs to search for similar past cases
DISCORD_SEARCH_CHANNEL_IDS=
# How many recent messages per channel to scan when searching
DISCORD_HISTORY_LIMIT=500

# ---- Agent behavior ----
# Seconds between Gmail polls in the continuous loop
POLL_INTERVAL_SECONDS=60
# Max similar cases to include in the briefing context
MAX_SIMILAR_CASES=5
# Path to the processed-message state file
STATE_FILE=state/processed.json
